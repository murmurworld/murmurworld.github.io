{"ticker":"PLTR","slug":"palantir","easy":{"line":"정부와 기업이 흩어진 데이터를 한곳에 모아 판단과 작업에 쓰게 하는 소프트웨어를 만든다. 정부용과 기업용 두 갈래다.","products":[{"name":"고담","plain":"국방·정보기관 같은 정부 고객용 데이터 분석 플랫폼이다.","terms":["data_platform"]},{"name":"파운드리","plain":"기업 고객용 데이터 분석 플랫폼이다. 반도체 파운드리와는 다른 말이다.","terms":["data_platform"]},{"name":"AIP","plain":"AI 모델을 회사 데이터와 업무 흐름에 연결해 쓰게 하는 도구다.","terms":["ai_model"]},{"name":"아폴로","plain":"이 소프트웨어들을 여러 장소의 서버에 깔고 업데이트하는 관리 도구다.","terms":[]}],"terms":[{"id":"data_platform","name":"데이터 분석 플랫폼","plain":"여러 곳에 흩어진 데이터를 한곳에 모아 서로 연결하고, 그 위에서 판단과 작업을 돕는 소프트웨어다."},{"id":"ai_model","name":"AI 모델","plain":"많은 글·그림·코드를 학습해 질문에 답하거나 글과 코드를 만들어 주는 프로그램이다.","where":"구글 제미나이, 엑스AI 그록, 알리바바 큐원 같은 것."}]},"annual":[{"id":"pltr-customer-segments-annual","titleKo":"정부·민간 고객 매출 · 연간","titleEn":"Annual government and commercial revenue","periods":[{"start":"2023-01-01","end":"2023-12-31","label":"2023-12-31","labelEn":"2023-12-31"},{"start":"2024-01-01","end":"2024-12-31","label":"2024-12-31","labelEn":"2024-12-31"},{"start":"2025-01-01","end":"2025-12-31","label":"2025-12-31","labelEn":"2025-12-31"}],"source":{"label":"10-K","url":"https://d18rn0p25nwr6d.cloudfront.net/CIK-0001321655/dc4b4ecd-85db-48ad-8253-35559c2544b1.html","filed":"2026-02-17","periodEnd":"2025-12-31"},"currency":"USD","unitKo":"백만 달러","unitEn":"USD million","measure":"revenue","rows":[{"key":"government","ko":"정부 고객","en":"Government","kind":"leaf","level":0,"parent":null,"values":[1222.215,1569.605,2402.287]},{"key":"commercial","ko":"민간 고객","en":"Commercial","kind":"leaf","level":0,"parent":null,"values":[1002.797,1295.902,2073.159]}],"total":[2225.012,2865.507,4475.446],"notes":[],"notesEn":[],"marks":[],"comparableFrom":"2023-12-31","compositionKeys":["government","commercial"],"compositionPeriods":["2023-12-31","2024-12-31","2025-12-31"]},{"id":"sec-consolidated-annual","titleKo":"SEC 연결 실적 · 연간","titleEn":"SEC consolidated results · Annual","currency":"USD","unitKo":"백만 미 달러","unitEn":"USD mi